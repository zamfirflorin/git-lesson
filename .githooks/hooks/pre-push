#.githooks/hooks/pre-push
#!/bin/bash
echo "test"
CURRENT_BRANCH=$(git rev-parse --abbrev-ref HEAD)
AUTHOR=$(git config user.name )
echo $CURRENT_BRANCH
echo $AUTHOR
pattern="^($AUTHOR)-(\([a-z0-9_-]+\))? .{1,30}"

 while read -r local_ref local_sha remote_ref remote_sha; do
    echo "$local_ref"
    echo "$local_sha"
    echo "$remote_ref"
    echo "$remote_sha"
done

if ! echo "$CURRENT_BRANCH" | grep -Eq "$pattern"; then
    echo "Nume branch invalid!"
    exit 1
fi