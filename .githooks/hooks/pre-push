#.githooks/hooks/pre-push
#!/bin/bash
echo "test"
CURRENT_BRANCH=$(git rev-parse --abbrev-ref HEAD)
AUTHOR=$(git config user.name )
echo $CURRENT_BRANCH
echo $AUTHOR
pattern="^($AUTHOR)(\([a-z0-9_-]+\))? .{1,30}"

 while read -r var1 var2 var3; do
    echo "$var1"
    echo "$var2"
    echo "$var3"
 done

if ! echo "$CURRENT_BRANCH" | grep -Eq "$pattern"; then
    echo "Nume branch invalid!"
    exit 1
fi